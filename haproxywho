# ---------------------------------------------------------------- findings

class Finding:
    """One structural finding. `fid` is a design-doc id (HA01..HA24)
    or "GEN" for a generic loader problem; `severity` is one of
    "finding", "warning", "info". `where` is "path:line" or None."""
    def __init__(self, fid, severity, message, where=None):
        self.fid = fid
        self.severity = severity
        self.message = message
        self.where = where

    def text(self):
        loc = " (%s)" % self.where if self.where else ""
        return "[%s] %s: %s%s" % (self.fid, self.severity, self.message, loc)

    def as_json(self):
        return {"id": self.fid, "severity": self.severity,
                "message": self.message, "where": self.where}


class FatalConfig(Exception):
    """A loader defect that ends the run (exit 2): .include cycle,
    a top-level file opening mid-section, unreadable config."""
    def __init__(self, message, where=None):
        super().__init__(message)
        self.message = message
        self.where = where


# ------------------------------------------------------------- three-valued

# Kleene three-valued logic values.
TRUE = "TRUE"
FALSE = "FALSE"
UNKNOWN = "UNKNOWN"


def tri_and(vals):
    if FALSE in vals:
        return FALSE
    if UNKNOWN in vals:
        return UNKNOWN
    return TRUE


def tri_or(vals):
    if TRUE in vals:
        return TRUE
    if UNKNOWN in vals:
        return UNKNOWN
    return FALSE


def tri_not(val):
    if val == TRUE:
        return FALSE
    if val == FALSE:
        return TRUE
    return UNKNOWN


# --------------------------------------------------------------- tokenizing

def tokenize(line):
    """Split a config line into tokens. `#` starts a comment outside
    quotes; single/double quotes group one token; a `#` inside
    quotes is literal. Backslash escapes the next char inside
    quotes. [documented, manual SS2.1/SS2.2]"""
    tokens = []
    cur = []
    quote = None
    i = 0
    while i < len(line):
        ch = line[i]
        if quote is not None:
            if ch == "\\" and i + 1 < len(line):
                cur.append(line[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
                i += 1
                continue
            cur.append(ch)
            i += 1
            continue
        if ch == "#":
            break
        if ch in ("'", '"'):
            quote = ch
            i += 1
            continue
        if ch.isspace():
            if cur:
                tokens.append("".join(cur))
                cur = []
            i += 1
            continue
        cur.append(ch)
        i += 1
    if cur:
        tokens.append("".join(cur))
    return tokens


ENV_REF_RE = re.compile(r"\$([A-Za-z_][A-Za-z0-9_]*)|\$\{[^}]*\}")


def has_env_ref(text):
    return bool(ENV_REF_RE.search(text))


# ------------------------------------------------------------ regex (HA15)

POSIX_CLASSES = {
    "alpha": "a-zA-Z", "digit": "0-9", "alnum": "a-zA-Z0-9",
    "space": r"\s", "upper": "A-Z", "lower": "a-z",
    "xdigit": "0-9A-Fa-f",
    "punct": r"""!\"#$%&'()*+,\-./:;<=>?@\[\\\]^_`{|}~""",
    "cntrl": r"\x00-\x1f\x7f", "print": r"\x20-\x7e",
    "graph": r"\x21-\x7e", "blank": " \t",
}


def translate_regex(pattern):
    """Translate a HAProxy (POSIX-ERE or PCRE, build-dependent)
    pattern to Python `re`. Returns the translated pattern, or None
    when the pattern uses constructs Python `re` cannot express the
    same way -- the caller then treats the term as UNKNOWN, never a
    guess. [regex-approx]"""
    out = []
    i = 0
    n = len(pattern)
    while i < n:
        ch = pattern[i]
        if ch == "[" and i + 1 < n and pattern[i + 1] == ":":
            # POSIX class [:name:] inside a bracket expression.
            j = pattern.find(":]", i + 2)
            if j == -1:
                return None
            name = pattern[i + 2:j]
            neg = name.startswith("^")
            if neg:
                name = name[1:]
            if name not in POSIX_CLASSES:
                return None
            out.append(("^" if neg else "") + POSIX_CLASSES[name])
            i = j + 2
            continue
        if ch == "(" and i + 1 < n and pattern[i + 1] == "?":
            # (?...) groups: only (?:...) is safe to carry over.
            if pattern.startswith("(?:", i):
                out.append("(?:")
                i += 3
                continue
            return None
        if ch == "\\" and i + 1 < n:
            nxt = pattern[i + 1]
            # Backreferences in matching are fine in Python re.
            if nxt.isdigit() and nxt != "0":
                out.append("\\" + nxt)
                i += 2
                continue
            if nxt in "dDsSwWbB":
                out.append("\\" + nxt)
                i += 2
                continue
            if nxt == "k":
                return None  # \k<name> named backref: not portable
            out.append("\\" + nxt)
            i += 2
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def regex_match(pattern, value):
    """Return TRUE/FALSE/UNKNOWN for a regex match attempt. The
    pattern is a HAProxy regex; translation failure is UNKNOWN."""
    translated = translate_regex(pattern)
    if translated is None:
        return UNKNOWN
    try:
        return TRUE if re.search(translated, value) else FALSE
    except re.error:
        return UNKNOWN


# ------------------------------------------------------------- match methods

MATCH_METHODS = ("str", "beg", "end", "sub", "dom", "dir", "reg",
                 "len", "int", "found")
INT_OPERATORS = ("eq", "ge", "gt", "le", "lt")
FETCH_SUFFIX_METHODS = ("beg", "end", "sub", "dom", "dir", "len",
                        "reg")


def match_str(method, value, pattern, case_insensitive):
    """String match of one pattern against one value. Returns a
    three-valued result (regex translation failure -> UNKNOWN)."""
    if case_insensitive:
        value = value.lower()
        pattern = pattern.lower()
    if method in (None, "str"):
        return TRUE if value == pattern else FALSE
    if method == "beg":
        return TRUE if value.startswith(pattern) else FALSE
    if method == "end":
        return TRUE if value.endswith(pattern) else FALSE
    if method == "sub":
        return TRUE if pattern in value else FALSE
    if method == "dom":
        # Dot-boundary suffix-or-equal: example.com dom-matches
        # www.example.com and itself, not badexample.com.
        if value == pattern or value.endswith("." + pattern):
            return TRUE
        return FALSE
    if method == "dir":
        if value == pattern or value.startswith(pattern + "/"):
            return TRUE
        return FALSE
    if method == "reg":
        return regex_match(pattern, value)
    if method == "found":
        return TRUE if value else FALSE
    return UNKNOWN


def match_int(operator, value, pattern):
    """Integer comparison. `pattern` may be a single integer or a
    range "lo-hi". Returns TRUE/FALSE/UNKNOWN."""
    try:
        if "-" in pattern and not pattern.startswith("-"):
            lo, hi = pattern.split("-", 1)
            lo, hi = int(lo), int(hi)
            return TRUE if lo <= value <= hi else FALSE
        num = int(pattern)
    except ValueError:
        return UNKNOWN
    op = operator or "eq"
    if op == "eq":
        return TRUE if value == num else FALSE
    if op == "ge":
        return TRUE if value >= num else FALSE
    if op == "gt":
        return TRUE if value > num else FALSE
    if op == "le":
        return TRUE if value <= num else FALSE
    if op == "lt":
        return TRUE if value < num else FALSE
    return UNKNOWN


def ip_matches(pattern, addr):
    """Does IP `addr` match `pattern` (IP, CIDR, or range)?
    Returns TRUE/FALSE, or UNKNOWN when the pattern is not an IP
    form at all (e.g. a hostname -- unresolvable statically)."""
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return UNKNOWN
    pat = pattern.strip()
    try:
        if "/" in pat:
            net = ipaddress.ip_network(pat, strict=False)
            return TRUE if ip in net else FALSE
        if "-" in pat:
            lo, hi = pat.split("-", 1)
            lo_ip = ipaddress.ip_address(lo.strip())
            hi_ip = ipaddress.ip_address(hi.strip())
            return TRUE if lo_ip <= ip <= hi_ip else FALSE
        return TRUE if ip == ipaddress.ip_address(pat) else FALSE
    except ValueError:
        return UNKNOWN
    except TypeError:
        # IPv4 pattern against an IPv6 address (or vice versa):
        # cannot match.
        return FALSE

